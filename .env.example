# Core
NODE_ENV=production
PORT=3000
TRUST_PROXY=1
PUBLIC_BASE_URL=https://lokritijewels.com
PRIMARY_HOST=lokritijewels.com

# Persistent media directory outside the deploy/release folder. Keep this path stable across redeploys.
DATA_DIR=../lokriti-data
UPLOAD_DIR=../lokriti-data/uploads

# Hostinger Managed MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lokriti
DB_USER=lokriti_user
DB_PASSWORD=CHANGE_ME
DB_POOL_SIZE=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Private admin
ADMIN_EMAIL=admin@lokritijewels.com
ADMIN_PASSWORD_HASH=PASTE_BCRYPT_HASH_HERE
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
RATE_LIMIT_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET

# Optional product-image object storage for horizontal scaling.
# Leave STORAGE_DRIVER=local on a single Hostinger app. Switch to s3 when using shared object storage.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Optional enquiry email notification (SMTP). Enquiries are always stored in MySQL.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Lokriti Jewels <no-reply@lokritijewels.com>
NOTIFY_EMAIL=Lokritijewels@gmail.com

# Optional error monitoring / analytics. Leave blank to disable.
SENTRY_DSN=

# Optional analytics. Leave blank to disable.
GA4_ID=
META_PIXEL_ID=
