# Railway / Node runtime
NODE_ENV=production
PORT=3000
TRUST_PROXY=1

# When testing on Railway, set these to the Railway public URL/domain.
# After GoDaddy is connected, change them to your real domain.
PUBLIC_BASE_URL=https://YOUR-RAILWAY-DOMAIN.up.railway.app
PRIMARY_HOST=YOUR-RAILWAY-DOMAIN.up.railway.app

# Railway MySQL service normally exposes these variables automatically.
# The app accepts both Railway MYSQL* names and generic DB_* names.
MYSQLHOST=
MYSQLPORT=3306
MYSQLDATABASE=
MYSQLUSER=
MYSQLPASSWORD=

# Optional generic DB_* names (use these if you prefer to map variables manually)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Railway Volume: if you attach a volume mounted at /data, these keep admin-uploaded
# product images persistent across redeploys. Without a volume, local uploads are ephemeral.
DATA_DIR=/data/lokriti-data
UPLOAD_DIR=/data/lokriti-data/uploads

# Private admin
ADMIN_EMAIL=admin@lokritijewels.com
ADMIN_PASSWORD_HASH=PASTE_A_NEW_BCRYPT_HASH_HERE
JWT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARS
RATE_LIMIT_SECRET=GENERATE_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARS

# Product image storage. Keep local for a single Railway instance with a persistent Volume,
# or use S3-compatible object storage for shared/horizontal deployments.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false

# Optional enquiry email notification
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Lokriti Jewels <no-reply@lokritijewels.com>
NOTIFY_EMAIL=Lokritijewels@gmail.com

# Optional monitoring / analytics
SENTRY_DSN=
GA4_ID=
META_PIXEL_ID=
